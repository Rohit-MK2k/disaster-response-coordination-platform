sequenceDiagram
    actor U as User (Admin/Contributor)
    participant API as HTTP Controller
    participant UC as UpdateDisasterUseCase (core)
    participant REPO as DisasterRepositoryPort -> InMemoryRepo
    participant GEO as GeocodingPort -> MockGeocodingAdapter

    U->>API: PATCH /disasters/:id { title?, description?, tags?, status? }
    API->>API: authenticate() -> AuthenticatedUser
    API->>UC: execute(id, dto, user)
    Note over UC: Authorization check:<br/>admin AND contributor may update
    UC->>REPO: findById(id)
    alt disaster not found
        REPO-->>UC: null
        UC-->>API: throws NotFoundError
        API-->>U: 404 Not Found
    else disaster found
        REPO-->>UC: existing Disaster
        alt dto.description provided
            UC->>UC: does existing.location.name still appear in new description?
            alt location name still present
                Note over UC: location assumed still valid<br/>NO geocoding call made
            else location name no longer present
                UC->>GEO: resolve(new description)
                GEO-->>UC: fresh { name, lat, lng }
                Note over UC: location replaced
            end
        else description not changed
            Note over UC: location untouched, no geocoding call
        end
        UC->>REPO: save(updatedDisaster)
        REPO-->>UC: saved Disaster
        UC-->>API: Disaster
        API-->>U: 200 OK { disaster }
    end
