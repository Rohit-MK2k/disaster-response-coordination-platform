sequenceDiagram
    actor U as User (Admin/Contributor)
    participant API as HTTP Controller
    participant UC as CreateDisasterUseCase (core)
    participant EXT as TextExtractionPort -> LlmExtractionAdapter
    participant GEO as GeocodingPort -> MockGeocodingAdapter
    participant CACHE as CachePort -> InMemoryCacheAdapter
    participant REPO as DisasterRepositoryPort -> InMemoryRepo

    U->>API: POST /disasters { text }
    API->>API: authenticate() -> AuthenticatedUser
    API->>UC: execute(text, user)
    UC->>UC: validate input (text non-empty)
    alt validation fails
        UC-->>API: throws ValidationError
        API-->>U: 400 Bad Request
    else validation passes
        UC->>EXT: extract(text)
        alt extraction fails/times out
            EXT-->>UC: throws ExtractionError
            UC-->>API: throws ExtractionError
            API-->>U: 422 Unprocessable Entity
        else extraction succeeds
            EXT-->>UC: { title, tags, locationText }
            UC->>CACHE: get(geocodeCacheKey(locationText))
            alt cache hit
                CACHE-->>UC: cached location
            else cache miss
                UC->>GEO: resolve(locationText)
                GEO-->>UC: { name, lat, lng }
                UC->>CACHE: set(geocodeCacheKey, location, ttl)
            end
            UC->>UC: build Disaster { title, description: text, tags, location }
            UC->>REPO: save(disaster)
            REPO-->>UC: saved Disaster
            UC-->>API: Disaster
            API-->>U: 201 Created { disaster }
        end
    end